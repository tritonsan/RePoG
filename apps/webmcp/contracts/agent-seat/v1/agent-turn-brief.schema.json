{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repog.dev/contracts/agent-seat/v1/agent-turn-brief.schema.json",
  "title": "RePoG Agent Turn Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session", "seat", "scene", "epistemic_projection", "continuity"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "turn_id", "turn_number", "revision"],
      "properties": {
        "session_id": { "$ref": "#/$defs/id" },
        "turn_id": { "type": "string", "minLength": 1, "maxLength": 180 },
        "turn_number": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "seat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat_id", "character_id", "character_ref", "role", "authority", "forbidden_authority", "capabilities"],
      "properties": {
        "seat_id": { "$ref": "#/$defs/id" },
        "character_id": { "$ref": "#/$defs/id" },
        "character_ref": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "authority": { "$ref": "#/$defs/textList" },
        "forbidden_authority": { "$ref": "#/$defs/textList" },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "summary", "pressure", "perceivable_facts", "affordances"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "summary": { "type": "string", "maxLength": 1200 },
        "pressure": { "type": "string", "maxLength": 600 },
        "perceivable_facts": { "$ref": "#/$defs/textList" },
        "affordances": { "$ref": "#/$defs/textList" },
        "entity_refs": { "$ref": "#/$defs/idList" },
        "owned_resource_refs": { "$ref": "#/$defs/idList" }
      }
    },
    "play_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "prioritized_values", "short_term_goal", "long_term_goal", "contradictions", "decision_rules", "voice_examples"],
      "properties": {
        "identity": { "$ref": "#/$defs/text" },
        "prioritized_values": { "$ref": "#/$defs/text" },
        "short_term_goal": { "$ref": "#/$defs/text" },
        "long_term_goal": { "$ref": "#/$defs/text" },
        "contradictions": { "$ref": "#/$defs/text" },
        "decision_rules": { "$ref": "#/$defs/textList" },
        "voice_examples": { "$ref": "#/$defs/textList" }
      }
    },
    "epistemic_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevant_knowledge", "relevant_memories", "knowledge_index"],
      "properties": {
        "relevant_knowledge": { "$ref": "#/$defs/textList" },
        "relevant_memories": { "$ref": "#/$defs/textList" },
        "self_knowledge": { "$ref": "#/$defs/textList" },
        "party_public_facts": { "$ref": "#/$defs/textList" },
        "knowledge_index": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/knowledge" } }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["last_action", "last_visible_result", "current_condition", "unresolved_personal_business"],
      "properties": {
        "last_action": { "type": "string", "maxLength": 600 },
        "last_visible_result": { "type": "string", "maxLength": 900 },
        "current_condition": { "type": "string", "maxLength": 500 },
        "unresolved_personal_business": { "type": "string", "maxLength": 600 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "textList": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/text" } },
    "idList": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "capability": { "type": "string", "enum": ["self.speak", "self.move", "self.use_owned_resource", "self.personal_commitment", "self.observe", "self.recall"] },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "text", "status", "source", "confidence", "learned_at_revision", "last_confirmed_revision"],
      "properties": {
        "fact_id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/text" },
        "status": { "enum": ["observed", "heard", "inferred", "suspected", "disproven", "misremembered"] },
        "source": { "$ref": "#/$defs/text" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "learned_at_revision": { "type": "integer", "minimum": 0 },
        "last_confirmed_revision": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
