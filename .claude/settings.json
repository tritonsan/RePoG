{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "RePoG",
  "autoMemoryEnabled": false,
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(python -B tools/*)",
      "Bash(python3 tools/*)",
      "Bash(python3 -B tools/*)",
      "Bash(py tools/*)",
      "Bash(py -B tools/*)",
      "Edit(/campaign/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(/campaign/.repog-transactions/**)"
    ]
  }
}
