  "avoid_phrases": [
    {
      "phrase": "a moment",
      "max_per_reply": 1,
      "note": "overused pause beat; show the pause through an action"
    },
    {
      "phrase": "a long moment",
      "max_per_reply": 0,
      "note": "stock beat"
    },
    {
      "phrase": "a beat",
      "max_per_reply": 1,
      "note": "screenplay beat in prose"
    },
    {
      "phrase": "said nothing else",
      "max_per_reply": 0,
      "note": "stock closing beat; let what the character does carry the silence"
    },
    {
      "phrase": "did not waver",
      "max_per_reply": 0,
      "note": "negated description; say how it sounded or looked"
    },
    {
      "phrase": "didn't waver",
