{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repog.dev/contracts/hosted-runtime/v1/player-intent-envelope.schema.json",
  "title": "Player Intent Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "expected_turn_id", "action"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "operation_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "expected_turn_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "action": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
