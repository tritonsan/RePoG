{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repog.dev/contracts/hosted-runtime/v1/runtime-event-envelope.schema.json",
  "title": "Runtime Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "sequence", "event_type", "public_payload", "seat_payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "session_id": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_type": { "enum": ["forge_progress", "turn_opened", "intent_pending", "turn_resolved", "session_paused", "session_complete", "runtime_error"] },
    "public_payload": { "type": "object" },
    "seat_payload": { "type": "object" }
  }
}
