{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repog.dev/contracts/agent-seat/v1/agent-session-pack.schema.json",
  "title": "RePoG Agent Session Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "game_contract", "characters", "session_policy"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "pack_id": { "$ref": "#/$defs/id" },
    "game_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "genre", "tone", "reality_rules", "table_boundaries"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "genre": { "$ref": "#/$defs/text" },
        "tone": { "$ref": "#/$defs/text" },
        "reality_rules": { "$ref": "#/$defs/textList" },
        "table_boundaries": { "$ref": "#/$defs/textList" }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/character" }
    },
    "session_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_active_seats", "run_policy", "ordinary_turn_approval", "stop_conditions"],
      "properties": {
        "max_active_seats": { "const": 1 },
        "run_policy": { "const": "continue_until_pause_or_complete" },
        "ordinary_turn_approval": { "const": "not_required" },
        "stop_conditions": { "$ref": "#/$defs/textList" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "textList": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/text" } },
    "capability": {
      "type": "string",
      "enum": ["self.speak", "self.move", "self.use_owned_resource", "self.personal_commitment", "self.observe", "self.recall"]
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "display_name", "role", "identity", "prioritized_values", "goals", "decision_rules", "contradictions", "voice_examples", "capabilities", "forbidden_authority", "knowledge_refs", "readiness"],
      "properties": {
        "character_id": { "$ref": "#/$defs/id" },
        "display_name": { "$ref": "#/$defs/text" },
        "role": { "$ref": "#/$defs/text" },
        "identity": { "$ref": "#/$defs/text" },
        "prioritized_values": { "$ref": "#/$defs/text" },
        "goals": { "$ref": "#/$defs/textList" },
        "decision_rules": { "$ref": "#/$defs/textList" },
        "contradictions": { "$ref": "#/$defs/text" },
        "voice_examples": { "$ref": "#/$defs/textList" },
        "capabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } },
        "forbidden_authority": { "$ref": "#/$defs/textList" },
        "knowledge_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "readiness": { "enum": ["ready", "paused"] }
      }
    }
  }
}
