{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repog.dev/contracts/agent-seat/v1/agent-intent-envelope.schema.json",
  "title": "RePoG Agent Intent Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "expected_turn_id", "expected_source_revision", "actor_id", "action_type", "action", "targets", "resource_refs", "knowledge_refs", "requested_effect", "asserted_outcomes"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "operation_id": { "$ref": "#/$defs/id" },
    "expected_turn_id": { "type": "string", "minLength": 1, "maxLength": 180 },
    "expected_source_revision": { "type": "integer", "minimum": 0 },
    "actor_id": { "$ref": "#/$defs/id" },
    "action_type": { "$ref": "#/$defs/id" },
    "action": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "approach": { "type": "string", "maxLength": 600, "default": "" },
    "speech": { "type": "string", "maxLength": 1200, "default": "" },
    "targets": { "$ref": "#/$defs/idList" },
    "resource_refs": { "$ref": "#/$defs/idList" },
    "knowledge_refs": { "$ref": "#/$defs/idList" },
    "requested_effect": { "type": "string", "maxLength": 500 },
    "asserted_outcomes": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "idList": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
  }
}
